# Copy to `.env` and edit as needed.

# Port on the host that maps to nginx :80 inside the container.
HOST_PORT=8080

# Bind address. Keep 127.0.0.1 if a reverse proxy (Caddy/Traefik/nginx) is in front.
# Change to 0.0.0.0 ONLY if you have TLS + auth in front.
BIND_ADDR=0.0.0.0

# Container timezone.
# TZ=UTC
TZ=Asia/Dhaka